<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Sensord</RootNamespace>
    <AssemblyName>sensord</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Folder publish on purpose (no PublishSingleFile): single-file self-extraction
       plus the Defender scan of the unpacked bundle can blow the SCM 30 s service
       start window, and compressed assemblies load as private memory instead of
       shareable file mappings.
       Deliberately NO PublishTrimmed: LibreHardwareMonitorLib
       relies on WMI/COM and reflection and is not trim-safe. Enabling trimming makes
       the SDK emit BuiltInComInterop.IsSupported=false into runtimeconfig.json (on
       every build, not just publish), which disables COM and breaks Storage and
       Motherboard sensor enumeration. -->
  <PropertyGroup>
    <!-- Workstation, non-concurrent GC: a single-client snapshot streamer gains
         nothing from server/background GC heaps, which cost tens of MB. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPgo>true</TieredPgo>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the heap tight for the whole session: ~1 snapshot/s of JSON
         strings never justifies the default growth-oriented heap sizing. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="6" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sensord.Tests" />
  </ItemGroup>
</Project>
