<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Sensord</RootNamespace>
    <AssemblyName>sensord</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Publish-only flags. Deliberately NO PublishTrimmed: LibreHardwareMonitorLib
       relies on WMI/COM and reflection and is not trim-safe. Enabling trimming makes
       the SDK emit BuiltInComInterop.IsSupported=false into runtimeconfig.json (on
       every build, not just publish), which disables COM and breaks Storage and
       Motherboard sensor enumeration. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sensord.Tests" />
  </ItemGroup>
</Project>
